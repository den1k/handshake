# Handshake settings. Read by `npm start`; keep this file private.

# Google sign-in (see README: "Set up Google sign-in").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The address people open Handshake at. Google sends them back to BASE_URL/auth/google/callback.
# BASE_URL=http://localhost:4317

# Groq API key for rule checks (https://console.groq.com/keys).
GROQ_API_KEY=

# Optional: use another OpenAI-compatible endpoint or model instead of Groq's gpt-oss-20b.
# AI_URL=https://api.groq.com/openai/v1/chat/completions
# AI_MODEL=openai/gpt-oss-20b

# Email for signing codes and certificates. Set one of these; without either, emails are saved to data/outbox.
# RESEND_API_KEY=
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=Handshake <handshake@example.com>
